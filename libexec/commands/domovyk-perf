#!/bin/bash
# domovyk:summary=Show load, memory, pressure, top processes, thermals and power profile
# domovyk:tier=read
# domovyk:args=[--boot] [--sample <1-10>] [--json] [--raw]
# domovyk:examples=domovyk perf | domovyk perf --boot | domovyk perf --sample 5 --json
#
# Performance facts (requirement 12). Every file Source is read through
# dv_path, so tests can point DOMOVYK_SYSROOT at a fixture tree. --sample
# reads /proc/stat and /proc/diskstats, sleeps, and reads them again; it runs
# last so that the command's own work does not count as load.
set -euo pipefail
# shellcheck source=../lib/domovyk.sh
source "$DOMOVYK_LIBEXEC/lib/domovyk.sh"
dv_init domovyk.perf.v1 "" "$@"
shopt -s nullglob

want_boot=0 sample="" sample_set=0
set -- "${DV_ARGS[@]}"
while (($#)); do
  case $1 in
    --boot)
      want_boot=1
      shift
      ;;
    --sample)
      (($# >= 2)) || dv_usage "--sample needs a number of seconds from 1 to 10"
      sample=$2 sample_set=1
      shift 2
      ;;
    --sample=*)
      sample=${1#*=} sample_set=1
      shift
      ;;
    *) dv_usage "unexpected argument: $1" ;;
  esac
done
if ((sample_set)); then
  if ! [[ $sample =~ ^[0-9]{1,3}$ ]] || ((10#$sample < 1 || 10#$sample > 10)); then
    dv_usage "--sample takes whole seconds from 1 to 10, not '$sample'"
  fi
  sample=$((10#$sample))
fi

P=$DV_TMP/parts
mkdir "$P"

# All Sources together get at most BUDGET seconds, so that perf finishes
# within 30 s with a 10 s sample even when several Sources hang (3.4).
BUDGET=18
t_left() {
  local t=$DOMOVYK_TIMEOUT left=$((BUDGET - SECONDS))
  ((left >= t)) || t=$left
  ((t >= 1)) || t=1
  printf '%s' "$t"
}

# part <key>: stores the JSON value on stdin as the body's <key> (null when
# stdin is empty).
part() { jq -cs --arg k "$1" '{($k): (if length == 0 then null else .[0] end)}' >"$P/$1.json"; }

# rd <file>: prints the first line of a file; fails when it cannot be read.
rd() {
  local line=""
  { IFS= read -r line || [[ -n $line ]]; } 2>/dev/null <"$1" || return 1
  printf '%s' "$line"
}

# file_source <path> [hint]: prints where to read a file Source, or records it
# as unavailable (missing or permission) and fails.
file_source() {
  local p
  p=$(dv_path "$1")
  if [[ -r $p ]]; then
    printf '%s' "$p"
    return 0
  fi
  if [[ -e $p ]]; then
    dv_unavailable "$1" permission
  else
    dv_unavailable "$1" missing "" "${2:-}"
  fi
  return 1
}

# --- load and CPU count -------------------------------------------------------

if f=$(file_source /proc/loadavg); then
  jq -Rs 'try (rtrimstr("\n") | split(" ") as $a | ($a[3] | split("/")) as $r
    | {avg1: ($a[0] | tonumber), avg5: ($a[1] | tonumber), avg15: ($a[2] | tonumber),
       running: ($r[0] | tonumber), total: ($r[1] | tonumber)}) catch null' "$f"
fi | part load

if dv_source nproc --timeout "$(t_left)" --package coreutils -- nproc && ((DV_RC == 0)); then
  jq -Rs 'try (rtrimstr("\n") | tonumber) catch null' "$DV_OUT"
fi | part cpu_count

# --- memory, swap and zram ----------------------------------------------------

mem=$DV_TMP/meminfo.json
echo '{}' >"$mem"
if f=$(file_source /proc/meminfo); then
  jq -Rn '[inputs | capture("^(?<k>[^:]+):\\s+(?<v>[0-9]+)(?<kb> kB)?")
    | {key: .k, value: ((.v | tonumber) * (if .kb then 1024 else 1 end))}] | from_entries' \
    "$f" >"$mem" || echo '{}' >"$mem"
fi

jq 'def r1: . * 10 | round / 10;
  if .MemTotal and .MemAvailable then
    {total_bytes: .MemTotal, available_bytes: .MemAvailable,
     used_bytes: (.MemTotal - .MemAvailable),
     used_percent: (if .MemTotal > 0 then ((.MemTotal - .MemAvailable) / .MemTotal * 100 | r1) else null end)}
  else null end' "$mem" | part memory

swaps=$DV_TMP/swaps.json
echo '[]' >"$swaps"
if f=$(file_source /proc/swaps); then
  jq -Rn '[inputs | select(startswith("Filename") | not) | [splits("\\s+")] | select(length >= 5)
    | {name: (.[0] | gsub("\\\\040"; " ")), type: .[1],
       size_bytes: ((.[2] | tonumber) * 1024), used_bytes: ((.[3] | tonumber) * 1024),
       priority: (.[4] | tonumber)}]' "$f" >"$swaps" || echo '[]' >"$swaps"
fi
jq --slurpfile d "$swaps" 'def r1: . * 10 | round / 10;
  if .SwapTotal != null and .SwapFree != null then
    {total_bytes: .SwapTotal, free_bytes: .SwapFree, used_bytes: (.SwapTotal - .SwapFree),
     used_percent: (if .SwapTotal > 0 then ((.SwapTotal - .SwapFree) / .SwapTotal * 100 | r1) else null end),
     devices: $d[0]}
  else null end' "$mem" | part swap

# zram devices that have a size; mm_stat holds orig, compressed and used bytes.
for z in "$(dv_path /sys/block)"/zram*; do
  size=$(rd "$z/disksize") || continue
  if ! [[ $size =~ ^[0-9]+$ ]] || ((size == 0)); then continue; fi
  algo=$(rd "$z/comp_algorithm") || algo=""
  mm=$(rd "$z/mm_stat") || mm=""
  printf '%s\t%s\t%s\t%s\n' "${z##*/}" "$size" "$algo" "$mm"
done | jq -Rn '[inputs | split("\t")
  | (.[3] // "" | [splits("\\s+") | select(length > 0) | tonumber?]) as $m
  | {device: .[0], disksize_bytes: (.[1] | tonumber),
     algorithm: (.[2] // "" | (capture("\\[(?<a>[^]]+)\\]") | .a) // (if . == "" then null else . end)),
     orig_data_bytes: $m[0], compr_data_bytes: $m[1], mem_used_bytes: $m[2]}]' | part zram

# --- pressure stall information -----------------------------------------------

pdir=$(dv_path /proc/pressure)
if [[ -d $pdir ]]; then
  for r in cpu memory io; do
    if f=$(file_source "/proc/pressure/$r"); then
      jq -Rn --arg r "$r" '{($r): ([inputs
        | capture("^(?<kind>some|full) avg10=(?<a10>[0-9.]+) avg60=(?<a60>[0-9.]+) avg300=(?<a300>[0-9.]+) total=(?<t>[0-9]+)")
        | {key: .kind, value: {avg10: (.a10 | tonumber), avg60: (.a60 | tonumber),
            avg300: (.a300 | tonumber), total_us: (.t | tonumber)}}]
        | from_entries | {some: (.some // null), full: (.full // null)})}' "$f"
    else
      jq -n --arg r "$r" '{($r): null}'
    fi
  done | jq -s 'add' | part pressure
else
  dv_unavailable /proc/pressure missing "" \
    "the kernel runs without pressure stall information (boot option psi=1)"
  part pressure </dev/null
fi

# --- top processes ------------------------------------------------------------

# ps %cpu is CPU time divided by run time since each process started. Our
# own timeout and ps (a child of this shell and its child) are left out:
# ps rates a process that started a moment ago at up to 100 %.
procs=$DV_TMP/procs.json
echo null >"$procs"
if dv_source ps --timeout "$(t_left)" --package procps -- \
  ps -eo pid=,ppid=,uid=,pcpu=,rss=,comm= && ((DV_RC == 0)); then
  jq -Rn --slurpfile mem "$mem" --argjson self "$$" '($mem[0].MemTotal // null) as $t
    | [inputs | capture("^\\s*(?<pid>[0-9]+)\\s+(?<ppid>[0-9]+)\\s+(?<uid>[0-9]+)\\s+(?<cpu>[0-9.]+)\\s+(?<rss>[0-9]+) (?<comm>.*)$")
      | {pid: (.pid | tonumber), ppid: (.ppid | tonumber), uid: (.uid | tonumber), command: .comm,
         cpu_percent: (.cpu | tonumber), rss_bytes: ((.rss | tonumber) * 1024)}
      | .memory_percent = (if $t and $t > 0 then (.rss_bytes / $t * 1000 | round / 10) else null end)]
    | (map(select(.ppid == $self) | .pid)) as $kids
    | map(select((.pid | IN($kids[])) or (.ppid | IN($kids[])) | not) | del(.ppid))' \
    "$DV_OUT" >"$procs" || echo null >"$procs"
fi
jq 'if . == null then null else sort_by(-.cpu_percent, .pid) | .[:10] end' "$procs" | part top_cpu
jq 'if . == null then null else sort_by(-.rss_bytes, .pid) | .[:10] end' "$procs" | part top_memory

# --- thermal zones, throttling, power profile --------------------------------

for z in "$(dv_path /sys/class/thermal)"/thermal_zone*; do
  type=$(rd "$z/type") || type=""
  temp=$(rd "$z/temp") || temp=""
  printf '%s\t%s\t%s\n' "${z##*/}" "$type" "$temp"
done | jq -Rn '[inputs | split("\t")
  | {zone: .[0], type: (if .[1] == "" then null else .[1] end),
     celsius: (.[2] | if test("^-?[0-9]+$") then (tonumber / 100 | round / 10) else null end)}]
  | sort_by(.zone | ltrimstr("thermal_zone") | tonumber? // 0)' | part thermal

# Intel CPUs count throttling events per core and per package since boot. The
# package counter is repeated on every CPU of the package, so it is counted
# once per physical package. Without counters (AMD, VMs), count kernel log
# lines of the current boot that mention throttling.
cpus=("$(dv_path /sys/devices/system/cpu)"/cpu[0-9]*/thermal_throttle)
if ((${#cpus[@]})); then
  for d in "${cpus[@]}"; do
    c=${d%/thermal_throttle}
    core=$(rd "$d/core_throttle_count") || core=""
    pkg=$(rd "$d/package_throttle_count") || pkg=""
    id=$(rd "$c/topology/physical_package_id") || id=0
    printf '%s\t%s\t%s\t%s\n' "${c##*/}" "$id" "$core" "$pkg"
  done | jq -Rn '[inputs | split("\t") | {cpu: .[0], package: .[1],
      core: (.[2] | tonumber? // null), pkg: (.[3] | tonumber? // null)}] as $c
    | ($c | map(.core // 0) | add) as $core
    | ($c | group_by(.package) | map(map(.pkg // 0) | max) | add) as $pkg
    | {source: "sysfs", events: ($core + $pkg), core_events: $core, package_events: $pkg,
       cpus_throttled: ($c | map(select((.core // 0) > 0)) | length)}' | part throttling
else
  if dv_source journalctl --timeout "$(t_left)" --package systemd -- \
    journalctl -k -b 0 --grep throttled -o cat --no-pager; then
    if grep -qE 'not seeing messages from other users|insufficient permissions' "$DV_ERR"; then
      dv_unavailable kernel-log permission "" "adm or systemd-journal group"
    elif ((DV_RC == 0 || DV_RC == 1)); then
      # journalctl --grep exits 1 when nothing matched.
      jq -Rn '[inputs | select(length > 0)] | length
        | {source: "kernel-log", events: ., core_events: null, package_events: null, cpus_throttled: null}' \
        "$DV_OUT"
    fi
  fi | part throttling
fi

if dv_have powerprofilesctl power-profiles-daemon; then
  if dv_source powerprofilesctl --timeout "$(t_left)" --package power-profiles-daemon -- \
    powerprofilesctl get; then
    if ((DV_RC == 0)) && [[ -s $DV_OUT ]]; then
      jq -Rs 'split("\n")[0]' "$DV_OUT"
    else
      dv_unavailable power-profiles-daemon missing power-profiles-daemon \
        "powerprofilesctl could not reach the daemon"
    fi
  fi
fi | part power_profile

# --- boot time (--boot) -------------------------------------------------------

if ((want_boot)); then
  if dv_source systemd-analyze --timeout "$(t_left)" --package systemd -- systemd-analyze time; then
    t_out=$DV_OUT t_err=$DV_ERR
    blame=$DV_TMP/blame.txt
    : >"$blame"
    if dv_source systemd-analyze --timeout "$(t_left)" --package systemd -- \
      systemd-analyze blame --no-pager && ((DV_RC == 0)); then
      blame=$DV_OUT
    fi
    # .device units are left out of the slowest list: their time is when the
    # device appeared, and their names carry disk serial numbers and EUIs.
    jq -n --rawfile t "$t_out" --rawfile e "$t_err" --rawfile b "$blame" '
      def secs: if . == null then null else
        [splits("\\s+") | select(length > 0)
         | capture("^(?<n>[0-9]+(\\.[0-9]+)?)(?<u>h|min|s|ms|us|µs)$")
         | (.n | tonumber) * ({"h": 3600, "min": 60, "s": 1, "ms": 0.001, "us": 0.000001, "µs": 0.000001}[.u])]
        | if length == 0 then null else add | . * 1000 | round / 1000 end end;
      ($t | split("\n")) as $lines
      | ($lines | map(capture("^Startup finished in (?<parts>.+) = (?<total>.+?)\\s*$")) | first) as $s
      | ($lines | map(capture("^(?<target>\\S+) reached after (?<after>.+?) in userspace")) | first) as $g
      | ($b | split("\n") | map(capture("^\\s*(?<t>.+?)\\s+(?<unit>\\S+)$"))
         | map(select(.unit | endswith(".device") | not) | {unit, seconds: (.t | secs)})
         | map(select(.seconds != null)) | sort_by(-.seconds) | .[:10]) as $slow
      | {finished: ($s != null),
         total_seconds: ($s.total | secs),
         phases: (if $s then ($s.parts | split(" + ")
           | map(capture("^(?<t>.+) \\((?<k>[a-z]+)\\)$") | {key: .k, value: (.t | secs)}) | from_entries)
           else null end),
         target: ($g.target // null), target_seconds: ($g.after | secs),
         message: (if $s then null else ($t + $e | split("\n") | map(select(length > 0)) | first) end),
         slowest: (if ($slow | length) > 0 then $slow else null end)}'
  fi | part boot
fi

# --- CPU and IO utilisation over an interval (--sample) -----------------------

if [[ -n $sample ]]; then
  file_source /proc/stat >/dev/null || true
  file_source /proc/diskstats >/dev/null || true
  snap() {
    cat -- "$(dv_path /proc/stat)" >"$DV_TMP/stat.$1" 2>/dev/null || : >"$DV_TMP/stat.$1"
    cat -- "$(dv_path /proc/diskstats)" >"$DV_TMP/diskstats.$1" 2>/dev/null || : >"$DV_TMP/diskstats.$1"
  }
  snap 1
  sleep "$sample"
  snap 2
  blocks=$DV_TMP/blocks.txt
  : >"$blocks"
  for b in "$(dv_path /sys/block)"/*; do printf '%s\n' "${b##*/}" >>"$blocks"; done
  # Whole disks only (the names under /sys/block), without loop and ram devices.
  jq -n --argjson n "$sample" --rawfile s1 "$DV_TMP/stat.1" --rawfile s2 "$DV_TMP/stat.2" \
    --rawfile d1 "$DV_TMP/diskstats.1" --rawfile d2 "$DV_TMP/diskstats.2" --rawfile bl "$blocks" '
    def r1: . * 10 | round / 10;
    def cpu: split("\n") | map(select(startswith("cpu "))) | first
      | if . == null then null else [splits("\\s+")] | .[1:9] | map(tonumber)
        | {total: add, idle: .[3], iowait: .[4]} end;
    def disks: split("\n") | map([splits("\\s+") | select(length > 0)] | select(length >= 13)
      | {key: .[2], value: {r: (.[5] | tonumber), w: (.[9] | tonumber), t: (.[12] | tonumber)}})
      | from_entries;
    def pos: if . < 0 then 0 else . end;
    ($bl | split("\n") | map(select(length > 0))) as $blocks
    | ($s1 | cpu) as $c1 | ($s2 | cpu) as $c2
    | (if $c1 and $c2 then $c2.total - $c1.total else 0 end) as $dt
    | ($d1 | disks) as $a | ($d2 | disks) as $b
    | {seconds: $n,
       cpu_busy_percent: (if $dt > 0 then
         (($dt - ($c2.idle - $c1.idle) - ($c2.iowait - $c1.iowait)) / $dt * 100 | pos | r1) else null end),
       cpu_iowait_percent: (if $dt > 0 then (($c2.iowait - $c1.iowait) / $dt * 100 | pos | r1) else null end),
       disks: [$b | to_entries[]
         | select(.key | test("^(loop|ram)[0-9]+$") | not)
         | select(($blocks | length) == 0 or (.key | IN($blocks[])))
         | select($a[.key] != null)
         | .key as $k | .value as $v | $a[$k] as $u
         | {device: $k,
            util_percent: (($v.t - $u.t) / ($n * 1000) * 100 | pos | if . > 100 then 100 else . end | r1),
            read_bytes_per_s: (($v.r - $u.r) * 512 / $n | pos | round),
            write_bytes_per_s: (($v.w - $u.w) * 512 / $n | pos | round)}]
         | sort_by(.device)}' | part sample
fi

body=$DV_TMP/body.json
jq -s 'add | {load, cpu_count, memory, swap, zram, pressure, top_cpu, top_memory,
  thermal, throttling, power_profile, boot, sample}' "$P"/*.json >"$body" ||
  dv_die assemble "could not merge the collected facts"
dv_emit "$body"
